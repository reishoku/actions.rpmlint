root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2
max_line_length = 80

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
max_line_length = off

[*.sh]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
# Markdown files naturally contain long lines (URLs, tables)
max_line_length = off

[Makefile]
indent_style = tab
